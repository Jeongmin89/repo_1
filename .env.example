# ── Claude API ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 모델 / 사고 깊이(low|medium|high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ── Kakao Developers ───────────────────────────────────────
# 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 '사용함'으로 했다면 입력 (아니면 비워두기)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 똑같이 등록해야 함
KAKAO_REDIRECT_URI=http://localhost:8000/oauth/kakao/callback
# 메시지의 '자세히 보기' 버튼 링크 (플랫폼 > Web 에 등록된 도메인이어야 함)
KAKAO_LINK_URL=http://localhost:8000
# 토큰 저장 위치
KAKAO_TOKEN_PATH=.kakao_token.json

# ── 웹 서버 ────────────────────────────────────────────────
# 외부에 공개할 경우 반드시 설정: 업로드 시 이 비밀번호가 필요함
APP_PASSWORD=
